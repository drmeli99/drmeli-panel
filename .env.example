# Obligatorias
APP_PASSWORD=elegi-una-clave-larga
# Texto largo y aleatorio (32+ caracteres). Cifra los tokens de MercadoLibre y firma la sesión. No cambiarlo.
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio-0123456789
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Base de datos: en Vercel la carga sola la integración de Neon (Storage → Neon).
# En local, poné tu conexión de Postgres:
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# Opcionales
# APP_URL: solo con dominio propio (en Vercel se detecta sola). En local: http://localhost:3000
APP_URL=
# CRON_SECRET: si no está, se deriva de AUTH_SECRET (las direcciones aparecen en Configuración)
CRON_SECRET=
# RESEND_API_KEY: para mandar alertas por email (resend.com)
RESEND_API_KEY=

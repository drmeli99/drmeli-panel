# Base de datos Postgres (Neon o Supabase). Usá la "pooled connection string".
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# Contraseña para entrar al panel
APP_PASSWORD=elegi-una-clave-larga

# Texto largo y aleatorio (32+ caracteres). Cifra los tokens de MercadoLibre y firma la sesión.
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio-0123456789

# Clave para que cron-job.org (y Vercel) puedan disparar las sincronizaciones
CRON_SECRET=otra-clave-larga-para-el-cron

# App de developers.mercadolibre.com.ar
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# URL pública de tu app (sin barra final), ej https://mi-panel.vercel.app
APP_URL=http://localhost:3000

# Opcional: email de alertas con Resend (resend.com, gratis 3000/mes)
RESEND_API_KEY=
